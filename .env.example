# Copy to .env and fill in. Never commit .env.

# Postgres connection string.
# Local (Docker): postgresql://mess:mess@localhost:5432/smart_mess?schema=public
# Production (Neon): paste the connection string from the Neon dashboard.
DATABASE_URL="postgresql://mess:mess@localhost:5432/smart_mess?schema=public"

# Signs login sessions. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Timezone for meal times and "today".
MESS_TIMEZONE="Asia/Karachi"
